# Local self-host development. Copy this file to .env and replace the marked values.
# The PostgreSQL password below is only a local example; never expose this database
# to the internet with the sample credentials.
POSTGRES_USER=gbloc
POSTGRES_PASSWORD=replace-local-database-password
POSTGRES_DB=gbloc
POSTGRES_PORT=5432
DATABASE_URL=postgresql://gbloc:replace-local-database-password@127.0.0.1:5432/gbloc
API_PORT=8080
WEB_PORT=5173
GBLOC_PUBLIC_ORIGIN=http://localhost:5173

# Required for signed sessions and local uploads. Generate a random value before use.
SESSION_SECRET=replace-with-a-random-secret

# Google sign-in. Set these to enable login; callback URL:
# http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GBLOC_OWNER_EMAIL=

# User-uploaded profile files: local is the standalone default; s3 is optional.
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./var/gbloc-storage
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
STORAGE_UPLOAD_SECRET=

# Optional Stripe billing. Keep disabled until your own account and webhook are configured.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
